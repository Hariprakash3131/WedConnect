# WedConnect Environment Configuration

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Supabase (Database, Auth, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Resend (Email Service)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="WedConnect <notifications@wedconnect.app>"

# Mapbox (Location Services & Geocoding)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# MCP Integrations (Optional / Architecture connectors)
GITHUB_ACCESS_TOKEN=ghp_your_github_token
VERCEL_ACCESS_TOKEN=your_vercel_token
FIGMA_ACCESS_TOKEN=your_figma_token

